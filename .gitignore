.env
node_modules/
dist/
.DS_Store

# Production secrets: database password, session secret.
# The template in deploy/env-production.template holds no real values and is
# the only version that may ever be committed.
.env.*
.env.gmail
server/.env.gmail

# Real company data - NEVER COMMIT
database/imports/*.csv
database/imports/*.xlsx
database/imports/*.xls
*.putty.log
*ont-sample*.txt
*ports*.txt
*olt-review*.json

# Legacy SPCL source data stored locally for migration only
/SPCL 2018 acco.accdb
/appl.csv
/copyofappl.csv

# Local backup output
deploy/backups/

# Describes how to reach the NAS. Holds no passwords, but not worth
# publishing. deploy/deploy.conf.template is the committed version.
deploy/deploy.conf

# Real staff lists: names and temp passwords, read by
# server/src/scripts/createEmployees.ts over stdin. The script is committed,
# the people are not. deploy/staff.example.json is the committed shape.
staff.json
staff*.json
!deploy/staff.example.json

# Local design work and one-off account maintenance notes
/kitchen-design/
/scratchpad/disconnection-diagnosis-2026-09-09.txt
