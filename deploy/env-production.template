# Copy to .env.production on the NAS and fill in real values.
# NEVER commit the filled-in file. It is the database and session key material.

# --- Where the SPCL shared folder lives on the NAS ---------------------------
# The real path on this NAS, found in TOS File Manager.
SPCL_DATA_ROOT=/Volume1/SPCL

# --- Database ----------------------------------------------------------------
POSTGRES_USER=spcl_user
POSTGRES_DB=spcl_db
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# --- Application -------------------------------------------------------------
# Generate with: openssl rand -hex 48
SESSION_SECRET=CHANGE_ME

# --- Gmail receipt and notification sender ----------------------------------
# Generate these once from the Internal OAuth client with:
#   cd server
#   npm run authorize:gmail -- /path/to/downloaded-oauth-client.json
# Copy the values from server/.env.gmail here. Never commit either real file.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=receipts@fywycable.com
GMAIL_SENDER_NAME=SPCL/FYWY Cable - Do Not Reply

# --- Five-day disconnection email reminders --------------------------------
# Keep disabled through the first deployment and preview the eligible customer
# list before deliberately changing this to true on the NAS.
EMAIL_REMINDERS_ENABLED=false
EMAIL_REMINDERS_HOUR=8
EMAIL_REMINDERS_MINUTE=0
EMAIL_REMINDERS_BATCH_SIZE=20
EMAIL_REMINDERS_DAILY_LIMIT=1500
EMAIL_REMINDERS_MAX_ATTEMPTS=3

# --- Huawei OLT read-only verification --------------------------------------
# Keep this blank until the controlled OLT test. The real value belongs only
# in .env.production on the NAS. Example shape (never commit real values):
# {"192.168.1.3":{"protocol":"ssh","port":22,"username":"...","password":"...","hostKeySha256":"SHA256:..."}}
HUAWEI_OLT_CONNECTIONS_JSON=

# Live activate/deactivate remains off by default. During the controlled test,
# enable it for exactly one spare/company customer ID, never a paying account.
HUAWEI_OLT_WRITES_ENABLED=false
HUAWEI_OLT_WRITE_CUSTOMER_IDS=
HUAWEI_OLT_ACCOUNT_ACTIONS_ENABLED=false
HUAWEI_OLT_ACCOUNT_ACTION_CUSTOMER_IDS=
HUAWEI_OLT_RECONNECTION_AUTOMATION_ENABLED=false
HUAWEI_OLT_RECONNECTION_AUTOMATION_MAX_PER_TICK=10

# Unattended delinquent-customer disconnection. Each affected OLT is saved
# once, 120 minutes after its completed run; the job survives API restarts.
HUAWEI_OLT_AUTOMATION_ENABLED=false
HUAWEI_OLT_AUTOMATION_HOUR=9
HUAWEI_OLT_AUTOMATION_MINUTE=0
HUAWEI_OLT_AUTOMATION_MAX_PER_RUN=100
HUAWEI_OLT_AUTOMATION_SAVE_DELAY_MINUTES=120

# Port staff computers on the home-office LAN connect to,
# e.g. http://192.168.1.8:8090
# Avoid 8181 and 8443 - TOS itself uses those.
SPCL_HTTP_PORT=8090

# false while the app is reached over plain HTTP on the LAN.
# true once the Cloudflare tunnel is serving it over HTTPS.
# Getting this wrong looks like a login that succeeds and then bounces
# straight back to the login page.
SESSION_COOKIE_SECURE=false

# --- Remote access (Cloudflare Tunnel) ---------------------------------------
# Only needed for the branch offices. Copy the token from the Cloudflare
# dashboard: Zero Trust > Networks > Tunnels > your tunnel > Docker.
# Leave blank until the tunnel is set up.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups -----------------------------------------------------------------
# Hour of the day, Jamaica time, for the nightly dump.
BACKUP_HOUR=2
DAILY_RETENTION_DAYS=30
MONTHLY_RETENTION_MONTHS=12
