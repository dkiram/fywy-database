# Copy this to deploy/deploy.conf and fill in your values.
#
#   cp deploy/deploy.conf.template deploy/deploy.conf
#
# deploy.conf is gitignored. It holds no passwords, but it does describe how
# to reach the NAS, which is not worth publishing.

# How to reach the NAS over SSH, as user@host.
#
# The username is whatever `whoami` reports when you are logged into the NAS.
# On this system it is SPCNAS, not admin or root.
#
# For the host, use the TAILSCALE address, not 192.168.1.8. The Tailscale
# address works both on the office network and from anywhere else, so there
# is nothing to switch between when you travel.
SPCL_SSH=SPCNAS@100.98.108.77

# TerraMaster's TOS runs SSH on 9222, not the usual 22.
SPCL_SSH_PORT=9222

# Where the repository lives on the NAS.
SPCL_REMOTE_DIR=/Volume1/SPCL/deployment

# Branch to deploy.
SPCL_BRANCH=main

# Set to "remote" if you are also running the Cloudflare tunnel container,
# otherwise leave empty. Getting this wrong stops the tunnel on every deploy.
SPCL_COMPOSE_PROFILES=

# How long to wait for PostgreSQL and then the API to come up, in seconds.
# Raise these if the NAS is slow or the database has grown large.
SPCL_DB_WAIT_SECONDS=60
SPCL_HEALTH_WAIT_SECONDS=60

# Absolute path to docker on the NAS. Leave empty and it is detected
# automatically via a login shell. Set it only if detection fails --
# find the value with:
#   ssh -p 9222 SPCNAS@100.98.108.77 'bash -lc "command -v docker"'
SPCL_DOCKER=

# Path ON THE NAS to the git credentials file. The repository is private, so
# the NAS needs a token to read it; the git that runs on the NAS (in a
# container, since TOS ships without git) reads this file.
#
# It is NOT in this repository and NOT on your laptop. Create it once on the
# NAS itself:
#
#   mkdir -p /Volume1/SPCL/secrets && chmod 700 /Volume1/SPCL/secrets
#   printf 'https://dkimaree-bot:github_pat_XXXX@github.com\n' \
#     > /Volume1/SPCL/secrets/git-credentials
#   chmod 600 /Volume1/SPCL/secrets/git-credentials
#
# Use a fine-grained personal access token on the dkimaree-bot account,
# scoped to the fywy-database repository only, with Contents: Read-only.
# Nothing else. If it ever leaks, revoke it on GitHub and write a new one.
#
# Keep it in a directory of its own, outside SPCL_REMOTE_DIR: the whole
# directory is mounted into the git container, and a stray `git clean` inside
# the deployment directory must never be able to delete it.
SPCL_GIT_CREDENTIALS=/Volume1/SPCL/secrets/git-credentials
