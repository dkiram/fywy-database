# Copy to .env.production on the NAS and fill in real values.
# NEVER commit the filled-in file. It is the database and session key material.

# --- Where the SPCL shared folder lives on the NAS ---------------------------
# Find the real path in TOS File Manager. On TerraMaster it usually looks like
# /mnt/md0/SPCL or /Volume1/SPCL. It must be the RAID 1 volume, not USB.
SPCL_DATA_ROOT=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=spcl_user
POSTGRES_DB=spcl_db
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Application -------------------------------------------------------------
# Generate with: openssl rand -hex 48
SESSION_SECRET=

# Port staff computers connect to on the NAS, e.g. http://192.168.1.8:8090
# Avoid 8181 and 8443 - TOS itself uses those.
SPCL_HTTP_PORT=

# Whether the session cookie is marked Secure, i.e. restricted to encrypted
# connections. One of:
#
#   auto  - decided per request. Anyone arriving over HTTPS through the
#           Cloudflare tunnel is protected; the home office on the plain-HTTP
#           LAN address keeps working. Correct for a mixed setup, which is
#           what this is.
#   true  - always. Only once EVERY office, home office included, reaches the
#           app over HTTPS. Setting this while anyone is still on
#           http://<nas-ip>:<port> locks them out, and the symptom is a login
#           that appears to succeed then bounces straight back to the form.
#   false - never. The old setting. Nobody is protected, branch offices
#           included, even when they arrive over HTTPS.
SESSION_COOKIE_SECURE=auto

# --- Backups -----------------------------------------------------------------
# Hour of the day, Jamaica time, for the nightly dump.
BACKUP_HOUR=2
DAILY_RETENTION_DAYS=30
MONTHLY_RETENTION_MONTHS=12